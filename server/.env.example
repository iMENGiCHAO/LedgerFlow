# LedgerFlow 后端环境配置模板
# 复制为 .env 并按本机实际情况修改(切勿提交真实 .env 到版本库)

# PostgreSQL 连接串:示例为本机免密;生产务必使用强口令账号并限制权限
DATABASE_URL="postgresql://your_user:your_password@127.0.0.1:5432/financial_mgmt?schema=public"

# JWT 密钥:生产必须替换为高强度随机值,生成方式 openssl rand -base64 48
# 长度 < 32 或包含 change-me 时,生产模式(NODE_ENV=production)将拒绝启动
JWT_SECRET="please-generate-a-strong-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# 服务端口(默认 3000,演示/文档环境用 3100)
PORT=3100

# 运行时目录(附件上传 / 数据库备份,相对 server/ 目录)
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"

# 跨域放行来源:留空 = 同源模式(推荐,前后端同域经 Nginx/Vite 代理);
# 分域部署时显式列出,如 "https://flow.example.com,https://admin.example.com"
CORS_ORIGIN=""

# 生产部署时设置
# NODE_ENV=production
